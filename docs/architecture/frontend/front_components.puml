@startuml

package "Front-end (React)" {

    [App] --> [AuthContext]

    package "Pages" {
        [Login]
        [Cadastro]
        [Feed]
        [DetalhePost]
        [CriarPost]
        [Perfil]
    }

    package "Components" {
        [Navbar]
        [LocationPicker]
    }

    package "Services" {
        [API Service]
        [Geocoding Service]
    }

    [Feed] --> [Navbar]
    [DetalhePost] --> [Navbar]
    [CriarPost] --> [Navbar]
    [Perfil] --> [Navbar]

    [CriarPost] --> [LocationPicker]
    [LocationPicker] --> [Geocoding Service]
    [DetalhePost] --> [Geocoding Service]

    [App] --> [API Service]

}

cloud "Nominatim (OpenStreetMap)" as Nominatim
[Geocoding Service] --> Nominatim

@enduml
